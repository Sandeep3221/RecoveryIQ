PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/recoveryiq
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Required for Stage 2. Use Razorpay Test Mode credentials only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# Required for Stage 3 webhook signature verification.
RAZORPAY_WEBHOOK_SECRET=
RECOVERY_SCORER=logistic
RECOVERY_NOTIFICATION_MODE=simulation
